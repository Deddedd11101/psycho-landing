# ============================================================
#  Пример переменных окружения.
#  Скопируйте файл: cp .env.example .env  (Windows: copy .env.example .env)
#  Файл .env в git НЕ попадает (см. .gitignore).
# ============================================================

# --- Telegram: обязательные ---------------------------------

# Токен бота, выданный @BotFather (формат 1234567890:AA...)
BOT_TOKEN=1234567890:AAExampleTokenReplaceMe

# Username бота без символа @ — используется для сборки ссылки t.me/<username>?start=...
BOT_USERNAME=my_psychologist_bot

# Числовой chat_id психолога — куда бот присылает заявки.
# Как узнать: напишите боту @userinfobot в Telegram, он вернёт ваш id.
PSYCHOLOGIST_CHAT_ID=123456789

# Публичный контакт психолога для клиента (username без @)
PSYCHOLOGIST_USERNAME=psy_anna

# --- Контент подтверждения записи ---------------------------

# Ссылка на онлайн-встречу, которую бот отправляет клиенту
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx
# Адрес очного приёма
OFFICE_ADDRESS=г. Москва, ул. Примерная, д. 1, офис 10

# --- Сервер -------------------------------------------------

# Порт локального Express-сервера
PORT=3001

# Публичный адрес сайта (используется в письмах/ссылках и при настройке вебхука)
PUBLIC_URL=http://localhost:5173

# Секрет для служебных эндпоинтов (/api/session/:id, /api/booking).
# Придумайте любую длинную случайную строку. Если пусто — проверка отключена (только для локальной разработки).
INTERNAL_API_TOKEN=

# Секрет вебхука Telegram (передаётся в заголовке X-Telegram-Bot-Api-Secret-Token).
TELEGRAM_WEBHOOK_SECRET=

# Запускать ли встроенный long-polling бота вместе с Express-сервером (для локальной разработки).
# На Vercel должно быть false — там используется вебхук.
USE_POLLING=true

# --- Хранилище сессий (опционально) -------------------------
# Без этих переменных сессии хранятся в памяти процесса.
# На Vercel (serverless) память между вызовами НЕ сохраняется, поэтому
# для продакшна подключите Upstash Redis (бесплатный тариф) — https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Время жизни сессии в секундах (по умолчанию 24 часа)
SESSION_TTL_SECONDS=86400

# --- Только для фронтенда (префикс VITE_) -------------------
# Базовый URL API. Пусто = тот же домен (используется прокси Vite в dev-режиме).
VITE_API_BASE_URL=
